# Monorepo root ignore rules

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/

# next.js
**/.next/
**/out/

# build outputs
**/build/
**/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!**/.env.example

# vercel
**/.vercel/

# typescript
*.tsbuildinfo
**/next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo


# omc
.omc/

# agent
.agent/
.agents/
# .claude/

# git worktrees
.worktrees/

# playwright-mcp screenshots / snapshots
.playwright-mcp/
**/.playwright-mcp/
/*.png
/*.jpg
/*.jpeg

#docs/*
!docs/hero-ui.txt
# seokit api-scaffold recon cache
.api-scaffold.json
